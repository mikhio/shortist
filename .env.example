# Скопируйте в `.env` и подставьте свои значения.
# `.env` НЕ попадает в репозиторий (см. .gitignore).

# PostgreSQL
DB_USER=shortist
DB_PASS=shortist
DB_HOST=postgres
DB_PORT=5432
DB_NAME=shortist

# Случайная строка минимум 32 байта — fastapi-users подписывает ею JWT
SECRET=change-me-to-a-long-random-string-minimum-32-bytes
